<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="32dp"
        android:paddingEnd="24dp"
        android:paddingBottom="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_app_mark"
                android:contentDescription="@null"
                android:padding="14dp"
                android:src="@drawable/ic_notifications" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/open_settings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings"
                android:padding="12dp"
                android:src="@drawable/ic_settings"
                android:tint="?attr/colorBrand" />
        </LinearLayout>

        <TextView
            style="@style/TextAppearance.DropDownStatusBar.Headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/setup_title" />

        <TextView
            style="@style/TextAppearance.DropDownStatusBar.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/setup_description" />

        <TextView
            android:id="@+id/service_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:paddingHorizontal="16dp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/enable_service"
            style="@style/Widget.DropDownStatusBar.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="@string/enable_service" />

        <TextView
            style="@style/TextAppearance.DropDownStatusBar.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/default_action_title" />

        <RadioGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="8dp">

            <RadioButton
                android:id="@+id/action_notifications"
                style="@style/DropDownStatusBarOption"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/open_notifications" />

            <RadioButton
                android:id="@+id/action_quick_settings"
                style="@style/DropDownStatusBarOption"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/open_quick_settings" />
        </RadioGroup>

        <TextView
            style="@style/TextAppearance.DropDownStatusBar.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/feedback_title" />

        <Switch
            android:id="@+id/vibration_switch"
            style="@style/DropDownStatusBarOption"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:paddingHorizontal="16dp"
            android:text="@string/vibrate_on_action" />

        <TextView
            style="@style/TextAppearance.DropDownStatusBar.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/test_title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/test_notifications"
                style="@style/Widget.DropDownStatusBar.SecondaryButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/test_notifications" />

            <Button
                android:id="@+id/test_quick_settings"
                style="@style/Widget.DropDownStatusBar.SecondaryButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/test_quick_settings" />
        </LinearLayout>

        <TextView
            style="@style/TextAppearance.DropDownStatusBar.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/widget_title" />

        <TextView
            style="@style/TextAppearance.DropDownStatusBar.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:text="@string/widget_description" />

        <TextView
            style="@style/TextAppearance.DropDownStatusBar.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/privacy_summary_title" />

        <TextView
            style="@style/TextAppearance.DropDownStatusBar.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/accessibility_disclosure" />

        <Button
            android:id="@+id/open_privacy"
            style="@style/Widget.DropDownStatusBar.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="@string/privacy_policy" />
    </LinearLayout>
</ScrollView>

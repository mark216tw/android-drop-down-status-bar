<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/close_settings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="-12dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/back"
                android:padding="12dp"
                android:src="@drawable/ic_arrow_back"
                android:tint="?attr/colorBrand" />

            <TextView
                style="@style/TextAppearance.DropDownStatusBar.Headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/appearance_settings"
                android:textSize="26sp" />
        </LinearLayout>

        <TextView
            style="@style/TextAppearance.DropDownStatusBar.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/appearance_description" />

        <TextView
            style="@style/TextAppearance.DropDownStatusBar.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/theme_mode_title" />

        <RadioGroup
            android:id="@+id/theme_mode_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="8dp">

            <RadioButton
                android:id="@+id/theme_mode_system"
                style="@style/DropDownStatusBarOption"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/theme_mode_system" />

            <RadioButton
                android:id="@+id/theme_mode_light"
                style="@style/DropDownStatusBarOption"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/theme_mode_light" />

            <RadioButton
                android:id="@+id/theme_mode_dark"
                style="@style/DropDownStatusBarOption"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/theme_mode_dark" />
        </RadioGroup>

        <TextView
            style="@style/TextAppearance.DropDownStatusBar.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/theme_color_title" />

        <RadioGroup
            android:id="@+id/theme_color_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="8dp">

            <RadioButton
                android:id="@+id/theme_color_blue"
                style="@style/DropDownStatusBarColorOption.Blue"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/theme_color_blue" />

            <RadioButton
                android:id="@+id/theme_color_pink"
                style="@style/DropDownStatusBarColorOption.Pink"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/theme_color_pink" />

            <RadioButton
                android:id="@+id/theme_color_purple"
                style="@style/DropDownStatusBarColorOption.Purple"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/theme_color_purple" />

            <RadioButton
                android:id="@+id/theme_color_teal"
                style="@style/DropDownStatusBarColorOption.Teal"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/theme_color_teal" />

            <RadioButton
                android:id="@+id/theme_color_orange"
                style="@style/DropDownStatusBarColorOption.Orange"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/theme_color_orange" />

            <RadioButton
                android:id="@+id/theme_color_lime"
                style="@style/DropDownStatusBarColorOption.Lime"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/theme_color_lime" />
        </RadioGroup>
    </LinearLayout>
</ScrollView>
